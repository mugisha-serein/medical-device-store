# Active Life Medical Backend - Environment Variables

# Application
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://activelifemedical:activelifemedical@localhost:5433/activelifemedical
DATABASE_URL_SYNC=postgresql://activelifemedical:activelifemedical@localhost:5433/activelifemedical

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Flutterwave Payment Gateway
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET=
FLW_BASE_URL=https://api.flutterwave.com/v3

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@activelife.rw

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_BYPASS_IPS=[]
JWT_ADMIN_BYPASS=true

# Brute-force Protection
BF_MAX_FAILURES=5
BF_LOCKOUT_SECONDS=900
BF_WINDOW_SECONDS=900
